# ==============================================================================
# Hariyuka AI - Environment Configuration Example
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_ENV=development
PORT=8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# API 1 Gateway Configuration (e.g. 9Router Proxy or custom gateway)
# ------------------------------------------------------------------------------
API_1_BASE_URL=http://localhost:20128/v1
API_1_API_KEY=your_api_1_key_here
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=your_api_1_key_here

# ------------------------------------------------------------------------------
# API 2 Gateway Configuration (e.g. custom gateway / OpenRouter)
# ------------------------------------------------------------------------------
API_2_BASE_URL=https://api.your-second-gateway.com/v1
API_2_API_KEY=your_api_2_key_here
PRIMARY_AI_BASE_URL=https://api.your-second-gateway.com/v1
PRIMARY_AI_API_KEY=your_api_2_key_here

# ------------------------------------------------------------------------------
# Model Pipeline & Fallback Routing
# ------------------------------------------------------------------------------
MODEL_SERP_EXTRACTOR=ag/gemini-3.7-flash-high
MODEL_OUTLINE_GENERATOR=ag/gemini-3.7-flash-high
SERP_PROVIDER=api_1
SERP_FALLBACK_ENABLED=true
SERP_FALLBACK_MODEL=gemini-4-argon
SERP_FALLBACK_PROVIDER=api_2

MODEL_SECTION_WRITER=claude-opus-5-5
MODEL_SEO_POLISHER=claude-opus-5-5
WRITER_PROVIDER=api_2
WRITER_FALLBACK_ENABLED=true
WRITER_FALLBACK_MODEL=ag/claude-opus-4-6-thinking
WRITER_FALLBACK_PROVIDER=api_1

# ------------------------------------------------------------------------------
# Supabase Configuration (PostgreSQL + Auth + RLS)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# External Scraping APIs (Optional - Fallback to internal scraper if empty)
# ------------------------------------------------------------------------------
SERPER_API_KEY=your_serper_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
